from nltk.corpus import opinion_lexicon

from preprocess import flatten


def build_lexicon():

    lexicon = {}

    positive_words = set(opinion_lexicon.positive())
    negative_words = set(opinion_lexicon.negative())

    for word in positive_words:
        lexicon[word] = 1.0

    for word in negative_words:
        lexicon[word] = -1.0

    return lexicon


def apply_lexicon(sentences, lexicon):

    for token in flatten(sentences):

        polarity = lexicon.get(token.lemma, 0.0)

        token.prior_polarity = polarity

        # initially, shifted polarity == original polarity
        token.shifted_polarity = polarity

    return sentences


def lexicon_features(sentences):

    tokens = flatten(sentences)

    positive = [
        token.prior_polarity
        for token in tokens
        if token.prior_polarity > 0
    ]

    negative = [
        token.prior_polarity
        for token in tokens
        if token.prior_polarity < 0
    ]

    return {

        "lex_pos_sum": sum(positive),

        "lex_neg_sum": abs(sum(negative)),

        "lex_pos_count": len(positive),

        "lex_neg_count": len(negative),

        "lex_total_count": len(positive) + len(negative),

        "lex_polarity_sum": sum(positive) + sum(negative)
    }""")


