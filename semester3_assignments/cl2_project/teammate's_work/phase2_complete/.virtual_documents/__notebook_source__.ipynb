get_ipython().run_cell_magic("writefile", " /kaggle/working/compositional_rules.py", """
from config import (
    INTENSIFIERS,
    IRREALIS,
    IRREALIS_FACTOR,
    NEGATION_SHIFT
)

NEGATORS = {
    "not",
    "n't",
    "never",
    "no",
    "hardly"
}


def apply_shifters(
    sentences,
    intensifiers=None,
    negation_shift=NEGATION_SHIFT
):

    if intensifiers is None:
        intensifiers = INTENSIFIERS

    for sentence in sentences:

        tokens = sentence.tokens

        # reset polarity before applying rules
        for token in tokens:
            token.shifted_polarity = token.prior_polarity

        for i, token in enumerate(tokens):

            word = token.lemma.lower()

            if word in NEGATORS:

                for next_token in tokens[i+1:i+7]:
                    
                    if next_token.clause_id != token.clause_id:
                        break

                    if next_token.text in {",", ";", ".", "!"}:
                        break

                    if next_token.prior_polarity != 0:

                        if next_token.prior_polarity > 0:

                            next_token.shifted_polarity = (
                                next_token.prior_polarity
                                - negation_shift
                            )

                        else:

                            next_token.shifted_polarity = (
                                next_token.prior_polarity
                                + negation_shift
                            )

            

            if word in intensifiers:

                for next_token in tokens[i+1:i+4]:

                    if next_token.clause_id != token.clause_id:
                        break

                    if next_token.prior_polarity != 0:

                        next_token.shifted_polarity *= (
                            intensifiers[word]
                        )

                        break

        

            if word in IRREALIS:

                for next_token in tokens[i+1:i+7]:

                    if next_token.clause_id != token.clause_id:
                        break

                    if next_token.prior_polarity != 0:

                        next_token.shifted_polarity *= IRREALIS_FACTOR

    return sentences


def shifter_features(sentences):

    values = [
        token.shifted_polarity
        for sentence in sentences
        for token in sentence.tokens
        if token.prior_polarity != 0
    ]

    return {

        "shift_pos_mass": sum(
            max(0, x) for x in values
        ),

        "shift_neg_mass": sum(
            max(0, -x) for x in values
        ),

        "shift_sum": sum(values),

        "shift_abs": sum(
            abs(x) for x in values
        )
    }""")


